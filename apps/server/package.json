{
  "name": "@vibetree/server",
  "version": "0.0.1",
  "description": "VibeTree Server - standalone backend for web/mobile clients",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibetree/core": "workspace:*",
    "@vibetree/server-core": "workspace:*",
    "dotenv": "^16.3.1",
    "node-pty": "^1.1.0-beta34",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/qrcode": "^1.5.5",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
