# Server configuration
PORT=3002
HOST=0.0.0.0

# Default project path (optional)
PROJECT_PATH=/path/to/your/project

# Auto-load projects (comma-separated paths, first becomes default)
# DEFAULT_PROJECTS=/path/to/project1,/path/to/project2
DEFAULT_PROJECTS=

# Authentication (off by default; recommended when HOST=0.0.0.0)
# Set AUTH_REQUIRED=true and a username/password to require login in the web UI.
# AUTH_REQUIRED=true
# VIBETREE_USERNAME=admin
# VIBETREE_PASSWORD=change-me

# Secret used to sign device-pairing JWTs. Set a random value in production.
# JWT_SECRET=

# Terminate sessions idle for longer than this (milliseconds). Default: 24h.
# SESSION_IDLE_TIMEOUT_MS=86400000

# Development conveniences (never use in production):
# allow unauthenticated LAN connections while AUTH_REQUIRED=true
# ALLOW_INSECURE_LAN=1
